{
	"name": "language-nsis",
	"version": "12.0.0",
	"description": "Atom language support for NSIS, including grammar, snippets and build system",
	"license": "MIT",
	"type": "commonjs",
	"main": "lib/main.cjs",
	"types": "lib/main.d.cts",
	"scripts": {
		"build": "tsdown && node scripts/fetch-grammar.mjs",
		"dev": "npm run build -- --watch",
		"lint": "biome check",
		"prepublishOnly": "npm run build",
		"publish:ppm": "PPM_PUBLISH=1 ppm publish",
		"test": "node scripts/smoke.mjs"
	},
	"author": {
		"name": "Jan T. Sott",
		"url": "http://github.com/idleberg"
	},
	"keywords": [
		"nsis",
		"nullsoft",
		"installer",
		"setup",
		"windows",
		"build",
		"build tool",
		"compiler",
		"grammar",
		"language syntax"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/idleberg/atom-language-nsis.git"
	},
	"engines": {
		"pulsar": ">=1.131.0 <2.0.0"
	},
	"package-deps": [
		{
			"name": "linter",
			"minimumVersion": "2.0.0"
		},
		{
			"name": "linter-ui-default"
		},
		{
			"name": "atom-ide-datatip"
		},
		{
			"name": "atom-ide-definitions"
		},
		{
			"name": "atom-ide-outline"
		},
		{
			"name": "busy-signal",
			"minimumVersion": "2.0.0"
		},
		{
			"name": "console",
			"minimumVersion": "0.7.0"
		}
	],
	"activationHooks": [
		"source.nsis:root-scope-used",
		"source.nlf:root-scope-used"
	],
	"activationCommands": {
		"atom-workspace": [
			"NSIS:compile",
			"NSIS:compile-strict",
			"NSIS:convert-language-file",
			"NSIS:open-package-settings",
			"NSIS:show-compiler-flags",
			"NSIS:show-version"
		]
	},
	"providedServices": {
		"autocomplete.provider": {
			"versions": {
				"4.0.0": "provideAutocomplete"
			}
		},
		"code-actions": {
			"versions": {
				"0.1.0": "provideCodeActions"
			}
		},
		"code-format.file": {
			"versions": {
				"0.1.0": "provideFileCodeFormat"
			}
		},
		"code-format.onSave": {
			"versions": {
				"0.1.0": "provideOnSaveCodeFormat"
			}
		},
		"code-format.range": {
			"versions": {
				"0.1.0": "provideRangeCodeFormat"
			}
		},
		"definitions": {
			"versions": {
				"0.1.0": "provideDefinitions"
			}
		},
		"find-references": {
			"versions": {
				"0.1.0": "provideFindReferences"
			}
		},
		"outline-view": {
			"versions": {
				"0.1.0": "provideOutlines"
			}
		},
		"refactor": {
			"versions": {
				"0.1.0": "provideRefactor"
			}
		}
	},
	"consumedServices": {
		"atom-ide-busy-signal": {
			"versions": {
				"0.1.0": "consumeBusySignal"
			}
		},
		"console": {
			"versions": {
				"0.1.0": "consumeConsole"
			}
		},
		"console-panel": {
			"versions": {
				"^1.0.0": "consumeConsolePanel"
			}
		},
		"datatip": {
			"versions": {
				"0.1.0": "consumeDatatip"
			}
		},
		"linter-indie": {
			"versions": {
				"2.0.0": "consumeLinterV2"
			}
		},
		"signature-help": {
			"versions": {
				"0.1.0": "consumeSignatureHelp"
			}
		}
	},
	"dependencies": {
		"@nsis/lsp": "0.5.7",
		"@nsis/nlf": "^0.14.2",
		"atom-languageclient": "^1.16.1",
		"makensis": "^3.0.3"
	},
	"optionalDependencies": {
		"@nsis/lsp-darwin-arm64": "0.5.7",
		"@nsis/lsp-darwin-x64": "0.5.7",
		"@nsis/lsp-linux-arm64": "0.5.7",
		"@nsis/lsp-linux-arm64-musl": "0.5.7",
		"@nsis/lsp-linux-x64": "0.5.7",
		"@nsis/lsp-linux-x64-musl": "0.5.7",
		"@nsis/lsp-win32-arm64": "0.5.7",
		"@nsis/lsp-win32-x64": "0.5.7"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@idleberg/configs": "^0.4.2",
		"@pulsar-edit/types": "^1.131.0",
		"@types/node": "^26.6.2",
		"atom-package-deps": "^8.0.0",
		"tree-sitter-nsis": "0.4.1",
		"tsdown": "^0.23.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"zadeh": "file:./shims/zadeh"
	}
}
